# Supabase local, conforme supabase/config.toml:
# API 56321, Postgres 56322, Studio 56323, Mailpit 56324, analytics 56327.
# Cole URL e chaves de `supabase status`. Não commite o .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
ADMIN_EMAIL=
ADMIN_SENHA=
ADMIN_NOME=
ADMIN_CLINICA_ID=
# Assistente de voz (src/app/voz/actions.ts). Sem as duas, a action responde "Assistente de voz não configurado".
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Assinatura ICP-Brasil (src/domain/documento/icp.ts). Sem as quatro, o documento guarda a assinatura em texto composto.
# Certificado A1 (arquivo pfx/p12) em base64. Certificado A3 (token ou cartão) não entra neste adaptador de servidor.
# A URL é a do provedor contratado; o código não fixa marca nem endpoint.
ICP_BRASIL_URL=
ICP_BRASIL_CREDENCIAL=
ICP_BRASIL_CERTIFICADO_A1_BASE64=
ICP_BRASIL_CERTIFICADO_SENHA=
